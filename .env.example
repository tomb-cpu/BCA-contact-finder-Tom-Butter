# Composio API key (from https://app.composio.dev). Required for live results.
# Leave unset to run the app in demo mode with realistic mock data.
COMPOSIO_API_KEY=

# The Composio user/entity ID that has an Apollo connection authorized.
# Defaults to "default" if unset.
COMPOSIO_USER_ID=default

# Whether to automatically reveal email/phone (APOLLO_PEOPLE_ENRICHMENT) for
# every result. Each enrichment consumes Apollo credits. Set to "false" to
# only show search-level data (name, title, LinkedIn) without spending credits.
APOLLO_AUTO_ENRICH=true
